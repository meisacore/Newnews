PRIVY_APP_ID=cmvjqf2i1030e0hl9wck83jj1
# Optional override: ES256 public PEM key. Otherwise fetched from Privy JWKS.
# Never put an app secret here.
PRIVY_VERIFICATION_KEY=
NORX_DB=data/norx.sqlite3
# Explicit local-only testing mode. Must remain off for public deployment.
NORX_DEV_AUTH=0

# Optional: set to 0 only when running a dedicated worker separately.
NORX_AUTO_WORKER=1

# Optional: backend-only PostgreSQL URL. Leave empty to keep local SQLite.
# In Supabase, use Connect -> Session pooler (port 5432), not transaction pooler.
# Set this privately in your terminal or hosting environment. Never VITE_DATABASE_URL.
DATABASE_URL=
# Each economy gets a private schema under this prefix.
NORX_PG_SCHEMA_PREFIX=norx_
